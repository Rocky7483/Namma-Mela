<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/primary_background" android:orientation="vertical" android:padding="16dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Fan Wall" android:textColor="@color/primary_text" android:textSize="26sp" android:textStyle="bold" />
    <EditText android:id="@+id/messageInput" android:layout_width="match_parent" android:layout_height="80dp" android:layout_marginTop="10dp" android:background="@drawable/bg_card" android:gravity="top" android:hint="Leave applause" android:padding="12dp" />
    <Button android:id="@+id/postButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:text="Post" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/applauseList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="12dp" android:layout_weight="1" />
</LinearLayout>
