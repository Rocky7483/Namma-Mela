<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/primary_background" android:orientation="vertical" android:padding="16dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Namma Mela" android:textColor="@color/primary_text" android:textSize="28sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
        <EditText android:id="@+id/searchInput" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/bg_card" android:hint="Search natakas" android:padding="12dp" />
        <Button android:id="@+id/searchButton" android:layout_width="96dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:text="Search" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
        <Button android:id="@+id/todayChip" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="Today" />
        <Button android:id="@+id/tomorrowChip" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="6dp" android:layout_weight="1" android:text="Tomorrow" />
        <Button android:id="@+id/weekChip" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="6dp" android:layout_weight="1" android:text="Week" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/natakaList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="12dp" android:layout_weight="1" />
</LinearLayout>
