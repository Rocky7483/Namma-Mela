<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="12dp">
    <TextView android:id="@+id/bookingTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/primary_text" android:textStyle="bold" />
    <TextView android:id="@+id/bookingSeats" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/secondary_text" />
    <TextView android:id="@+id/bookingStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/primary_accent" />
    <Button android:id="@+id/cancelButton" android:layout_width="match_parent" android:layout_height="44dp" android:text="Cancel Booking" />
</LinearLayout>
