<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/primary_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Manage Natakas" android:textColor="@color/primary_text" android:textSize="26sp" android:textStyle="bold" />
        <EditText android:id="@+id/editingId" android:layout_width="1dp" android:layout_height="1dp" android:visibility="invisible" />
        <EditText android:id="@+id/titleInput" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:background="@drawable/bg_card" android:hint="Title" android:padding="12dp" />
        <EditText android:id="@+id/descInput" android:layout_width="match_parent" android:layout_height="76dp" android:layout_marginTop="8dp" android:background="@drawable/bg_card" android:hint="Description" android:padding="12dp" />
        <EditText android:id="@+id/posterInput" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:background="@drawable/bg_card" android:hint="Poster image URL" android:padding="12dp" />
        <EditText android:id="@+id/dateInput" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:background="@drawable/bg_card" android:hint="Date YYYY-MM-DD" android:padding="12dp" />
        <EditText android:id="@+id/timeInput" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:background="@drawable/bg_card" android:hint="Start time" android:padding="12dp" />
        <EditText android:id="@+id/durationInput" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:background="@drawable/bg_card" android:hint="Duration" android:padding="12dp" />
        <EditText android:id="@+id/venueInput" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:background="@drawable/bg_card" android:hint="Venue" android:padding="12dp" />
        <Button android:id="@+id/saveButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:text="Save Nataka" />
        <EditText android:id="@+id/castNameInput" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="14dp" android:background="@drawable/bg_card" android:hint="Cast name" android:padding="12dp" />
        <EditText android:id="@+id/castRoleInput" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:background="@drawable/bg_card" android:hint="Cast role" android:padding="12dp" />
        <EditText android:id="@+id/castPhotoInput" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:background="@drawable/bg_card" android:hint="Cast photo URL" android:padding="12dp" />
        <EditText android:id="@+id/castBioInput" android:layout_width="match_parent" android:layout_height="70dp" android:layout_marginTop="8dp" android:background="@drawable/bg_card" android:hint="Biography" android:padding="12dp" />
        <EditText android:id="@+id/castExperienceInput" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:background="@drawable/bg_card" android:hint="Experience" android:padding="12dp" />
        <Button android:id="@+id/addCastButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:text="Add Cast" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/natakaList" android:layout_width="match_parent" android:layout_height="500dp" android:layout_marginTop="14dp" />
    </LinearLayout>
</ScrollView>
