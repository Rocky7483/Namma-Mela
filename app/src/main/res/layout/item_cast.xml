<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="132dp" android:layout_height="match_parent" android:layout_marginEnd="10dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="10dp">
    <ImageView android:id="@+id/castImage" android:layout_width="match_parent" android:layout_height="86dp" android:contentDescription="@string/app_name" android:scaleType="centerCrop" />
    <TextView android:id="@+id/castName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/primary_text" android:textSize="14sp" android:textStyle="bold" />
    <TextView android:id="@+id/castRole" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/secondary_text" android:textSize="12sp" />
</LinearLayout>
